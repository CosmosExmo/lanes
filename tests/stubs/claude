#!/usr/bin/env python3
import json
import sys
from _common import *

log("claude")
a = sys.argv[1:]
if a[:1] == ["--version"]:
    print("2.1.332 (Claude Code)")
elif a[:1] == ["--help"]:
    show_help("claude")
elif a[:2] == ["auth", "status"]:
    print(json.dumps({"loggedIn": not has("logged_out"),
                      "authMethod": "console" if has("api") else "claude.ai",
                      "email": EMAIL, "orgName": "Example Org"}))
elif "/usage" in a:
    text = fixture("claude_usage.txt")
    if has("fable_full"):
        text = text.replace("(Fable): 0% used", "(Fable): 100% used")
    print(json.dumps({"result": "no usage here" if has("usage_bad") else text, "num_turns": 0}))
else:
    model_call()
