#!/usr/bin/env python3
import json
import sys
from _common import *

log("claude")
a = sys.argv[1:]
if a[:1] == ["--version"]:
    print("2.1.332 (Claude Code)")
elif a[:1] == ["--help"]:
    show_help("claude")
elif a[:2] == ["auth", "status"]:
    print(json.dumps({"loggedIn": not has("logged_out"),
                      "authMethod": "console" if has("api") else "claude.ai",
                      "email": EMAIL, "orgName": "Example Org"}))
elif "/usage" in a:
    print(json.dumps({"result": "no usage here" if has("usage_bad") else fixture("claude_usage.txt"),
                      "num_turns": 0}))
else:
    model_call()
