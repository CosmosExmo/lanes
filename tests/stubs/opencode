#!/usr/bin/env python3
import json
import os
import sys
from _common import *

log("opencode")
a = sys.argv[1:]
chosen = dict(x.split(":") for x in os.environ.get("STUB_OC", "openai:oauth").split(","))
base = {"openai": "https://chatgpt.com/backend-api/codex", "deepseek": "https://api.deepseek.com"}
if a[:1] == ["--version"]:
    print("opencode v2.3.2")
elif a[:2] == ["run", "--help"]:
    show_help("opencode")
elif a[:2] == ["api", "provider.list"]:
    data = [{"id": i, "integrationID": i, "settings": {"baseURL": base.get(i, "https://x.example/v1")}}
            for i in chosen]
    data.append({"id": "opencode", "integrationID": "opencode", "settings": {"baseURL": "https://z.example"}})
    print(json.dumps({"location": {}, "data": data}))
elif a[:2] == ["api", "integration.list"]:
    data = [{"id": i, "connections": [{"type": "credential", "id": "c1", "method": m} for m in ms.split("+")]
             + ([{"type": "env", "id": "e1", "method": "key"}] if i == "openai" and os.environ.get("OPENAI_API_KEY") else [])}
            for i, ms in chosen.items()]
    data.append({"id": "opencode", "connections": []})
    print(json.dumps({"location": {}, "data": data}))
elif a[:1] == ["models"]:
    for i in chosen:
        print(f"{i}/model-a")
    print("opencode/free-model")
elif a[:1] == ["run"]:
    model_call()
else:  # export / credential.list expose secrets: tests assert we never get here
    sys.stderr.write("sk-secret-should-never-be-read\n")
    sys.exit(99)
