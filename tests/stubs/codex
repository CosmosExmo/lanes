#!/usr/bin/env python3
import json
import sys
from _common import *

log("codex")
a = sys.argv[1:]
if a[:1] == ["--version"]:
    print("codex-cli 0.172.0")
elif a[:2] == ["exec", "--help"]:
    show_help("codex")
elif a[:2] == ["debug", "models"]:
    print(json.dumps({"models": [
        {"slug": "gpt-5.6-luna", "visibility": "list"},
        {"slug": "gpt-6-sol", "visibility": "list"},
        {"slug": "internal-hidden", "visibility": "hide"}]}))
elif a[:1] == ["app-server"]:
    for line in sys.stdin:
        m = json.loads(line)
        if m.get("id") == 1:
            print(json.dumps({"id": 1, "result": {"userAgent": "stub", "email": EMAIL}}), flush=True)
        elif m.get("id") == 2:
            res = ({"rateLimits": {"primary": {"usedPercent": "x"}}} if has("rpc_bad")
                   else json.loads(fixture("codex_ratelimits.json")))
            print(json.dumps({"id": 2, "result": res}), flush=True)
else:
    model_call(a[a.index("-o") + 1] if "-o" in a else None)
